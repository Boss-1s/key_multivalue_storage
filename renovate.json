{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "vulnerabilityAlerts": {
        "enabled": false
    },
    "dependencyDashboard": false,
    "prConcurrentLimit": 0,
    "prHourlyLimit": 0,
    "branchPrefix": "deps/",
    "branchName": "deps/{{{baseBranch}}}/{{{branchTopic}}}",
    "ignorePaths": [],
    "includePaths": ["**"],
    "baseBranches": ["semver1.3.x", "semver1.4.x"],
    "useBaseBranchConfig": "merge"
}
