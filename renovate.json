{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "vulnerabilityAlerts": {
        "enabled": true
    },
    "dependencyDashboard": false,
    "prConcurrentLimit": 0,
    "prHourlyLimit": 0,
    "branchPrefix": "deps/",
    "additionalBranchPrefix": "semver1.4.x/",
    "ignorePaths": [],
    "includePaths": ["**"],
    "baseBranches": ["semver1.3.x", "semver1.4.x"],
    "useBaseBranchConfig": "merge"
}
