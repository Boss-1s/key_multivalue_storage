{
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.python-environments",
                "ms-python.debugpy",
                "ms-python.pylint",
                "ms-python.vscode-pylance",
                "ms-vscode.anycode",
                "davidanson.vscode-markdownlint",
                "ParisNeo.toml-hilighter",
                "fanaticpythoner.better-todo-tree",
                "mads-hartmann.bash-ide-vscode",
                "aaron-bond.better-comments",
                "tamasfe.even-better-toml",
                "github.vscode-github-actions",
                "omartawfik.github-actions-vscode",
                "marcovr.actions-shell-scripts",
                "oderwat.indent-rainbow",
                "davidanson.vscode-markdownlint",
                "pkief.material-icon-theme",
                "mintlify.document",
                "alefragnani.project-manager",
                "redhat.vscode-yaml"
            ]
        },
        "codespaces": {
            "repositories": {
                "Boss-1s/key_multivalue_storage": {
                    "permissions": "write"
                }
            }
        }
    },
    // Use 'postCreateCommand' to run commands after the container is created.
    "postCreateCommand": "pip install --upgrade pip && pip install uv && git remote set-url origin https://Boss-1s:$(gh auth token)@github.com && source /workspaces/key_multivalue_storage/.venv/bin/activate && uv sync --dev"
}
