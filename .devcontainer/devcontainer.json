{
    "name": "Key-to-Multivalue Storage Development Container",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "features": {
        "ghcr.io/devcontainers/features/python:1": {
            "version": "latest",
            "installJupyterlab": true
        },
        "ghcr.io/devcontainers/features/github-cli:1": {
            "version": "latest"
        }
    },
    "mounts": [
        "source=vscode-extensions,target=/root/.vscode-server,type=volume"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.python-environments",
                "ms-python.debugpy",
                "ms-python.pylint",
                "ms-python.vscode-pylance",
                "ms-vscode.anycode",
                "davidanson.vscode-markdownlint",
                "ParisNeo.toml-hilighter",
                "fanaticpythoner.better-todo-tree",
                "mads-hartmann.bash-ide-vscode",
                "aaron-bond.better-comments",
                "tamasfe.even-better-toml",
                "github.vscode-github-actions",
                "omartawfik.github-actions-vscode",
                "marcovr.actions-shell-scripts",
                "oderwat.indent-rainbow",
                "davidanson.vscode-markdownlint",
                "pkief.material-icon-theme",
                "mintlify.document",
                "alefragnani.project-manager",
                "redhat.vscode-yaml",
                "SonarSource.sonarlint-vscode",
                "ryanluker.vscode-coverage-gutters"
            ]
        },
        "codespaces": {
            "repositories": {
                "Boss-1s/key_multivalue_storage": {
                    "permissions": "write-all"
                }
            }
        }
    }
}
